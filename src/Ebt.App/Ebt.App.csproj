<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- No culture data (ICU) to download: the UI is German-only and formats explicitly. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- GitHub Pages compresses on its own and ignores pre-compressed .br/.gz files. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ebt.Content\Ebt.Content.csproj" />
    <ProjectReference Include="..\Ebt.Learning\Ebt.Learning.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ebt.App.Tests" />
  </ItemGroup>

</Project>
