@page "/practice"
@inject Catalog Catalog
@inject AppState State
@inject PracticeSession Session
@inject NavigationManager Nav

<TopBar Title="Üben" Back="" />

@if (run.Order.Count > 0 && !run.IsFinished)
{
    <button class="btn primary left hero" @onclick='() => Nav.NavigateTo("practice/run")'>
        <span><span class="display">Fortsetzen</span><small>@run.Mode.Label() · Frage @(run.Position + 1) von @run.Order.Count</small></span>
        <Icon Name="arrow-right" />
    </button>
}
<div class="card">
    <b>Neu starten</b>
    <div class="spacer"></div>
    <button class="btn left" @onclick="() => Start(PracticeMode.Order)">
        <span>@PracticeMode.Order.Label()<small>Frage 1 bis @Catalog.Questions.Count</small></span>
    </button>
    <button class="btn left" @onclick="() => Start(PracticeMode.Random)">
        <span>@PracticeMode.Random.Label()<small>Alle Fragen gemischt</small></span>
    </button>
    <button class="btn left" disabled="@(unseen == 0)" @onclick="() => Start(PracticeMode.Unseen)">
        <span>@PracticeMode.Unseen.Label()<small>@unseen noch nie beantwortet</small></span>
    </button>
</div>
<div class="card">
    <b>Zu Frage springen</b>
    <div class="spacer"></div>
    <form class="goto" @onsubmit="GoTo">
        <input type="number" inputmode="numeric" min="@first" max="@last" placeholder="@first–@last (NRW: @stateFirst–@stateLast)"
               aria-label="Fragenummer" required @bind="number" @bind:event="oninput">
        <button class="btn primary">Los</button>
    </form>
</div>

@code {
    private PracticeRun run = null!;
    private int unseen;
    private int? number;
    private int first, last, stateFirst, stateLast; // question numbers, for the hint

    protected override void OnInitialized()
    {
        run = Session.Run;
        unseen = Catalog.Questions.Count(q => State.Progress.IsNew(q.Number));
        (first, last) = (Catalog.Questions.Min(q => q.Number), Catalog.Questions.Max(q => q.Number));
        var state = Catalog.Questions.Where(q => q.IsState).Select(q => q.Number).ToList();
        (stateFirst, stateLast) = (state.Min(), state.Max());
    }

    private void Start(PracticeMode mode)
    {
        Session.Start(mode);
        Nav.NavigateTo("practice/run");
    }

    private void GoTo()
    {
        if (number is { } n && Session.StartAt(n)) Nav.NavigateTo("practice/run");
    }
}
