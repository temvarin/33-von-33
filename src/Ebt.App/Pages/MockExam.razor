@page "/exam"
@implements IDisposable
@inject Catalog Catalog
@inject AppState State
@inject Dialogs Dialogs
@inject TimeProvider Clock
@inject Random Random
@inject NavigationManager Nav

@if (exam is null)
{
    <TopBar Title="Prüfung simulieren" Back="" />
    <div class="card">
        <b>So läuft die Prüfung ab</b>
        <ul class="rules">
            <li>33 Fragen: 30 allgemeine + 3 zu NRW</li>
            <li>60 Minuten Zeit</li>
            <li>Bestanden ab 17 richtigen Antworten</li>
            <li>Die Lösungen siehst du erst am Ende</li>
        </ul>
    </div>
    <button class="btn primary" @onclick="Start">Prüfung starten</button>
}
else
{
    var remaining = exam.Remaining(Clock.GetUtcNow());
    <TopBar Title="Prüfung" Back="">
        <span class="timer @(remaining < TimeSpan.FromMinutes(5) ? "low" : "")">@((int)remaining.TotalMinutes):@remaining.Seconds.ToString("00")</span>
    </TopBar>
    <QuestionCard @key="exam.Position" Question="Catalog[exam.Questions[exam.Position]]" Label="@($"Frage {exam.Position + 1} von {exam.Questions.Count}")"
                  Chosen="exam.Answers[exam.Position]" Help="false" OnAnswer="Answer" />
    <div class="nav">
        <button class="btn" disabled="@(exam.Position == 0)" @onclick="() => GoTo(exam.Position - 1)"><Icon Name="arrow-left" />Zurück</button>
        <button class="btn" disabled="@(exam.Position == exam.Questions.Count - 1)" @onclick="() => GoTo(exam.Position + 1)">Weiter<Icon Name="arrow-right" /></button>
    </div>
    <div class="card overview">
        <div class="qmeta"><span>Übersicht</span><span>@exam.AnsweredCount / @exam.Questions.Count beantwortet</span></div>
        <div class="grid">
            @for (var i = 0; i < exam.Questions.Count; i++)
            {
                var position = i;
                <button class="@(exam.Answers[i] is not null ? "done" : "") @(i == exam.Position ? "current" : "")" @onclick="() => GoTo(position)">@(i + 1)</button>
            }
        </div>
    </div>
    <button class="btn primary" @onclick="ConfirmFinish">Prüfung abgeben</button>
}

@code {
    private Exam? exam;
    private ITimer? timer;
    private bool left; // the user left the page

    protected override void OnInitialized()
    {
        var progress = State.Progress;
        var now = Clock.GetUtcNow();
        if (progress.DropAbandonedExam(now)) State.Save();
        exam = progress.Exam;
        if (exam is null) return;
        if (exam.IsOver(now)) Finish();
        else StartTimer();
    }

    private void Start()
    {
        exam = State.Progress.StartExam(Catalog.Questions, Clock.GetUtcNow(), Random);
        State.Save();
        StartTimer();
    }

    private void StartTimer() =>
        timer = Clock.CreateTimer(_ => InvokeAsync(Tick), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

    private void Tick()
    {
        if (exam is null || State.Progress.Exam != exam) return;
        if (exam.IsOver(Clock.GetUtcNow()))
        {
            Finish();
            Dialogs.Alert("Die Zeit ist abgelaufen. Die Prüfung wurde automatisch abgegeben.");
            return;
        }
        StateHasChanged();
    }

    private async Task Answer(int answer)
    {
        var current = exam!;
        var next = current.Answer(answer);
        State.Save();
        // Move on to the next unanswered question after a short moment – unless the user left the exam meanwhile.
        await Task.Delay(250);
        if (left || State.Progress.Exam != current) return;
        current.GoTo(next);
        State.Save();
    }

    private void GoTo(int position)
    {
        exam!.GoTo(position);
        State.Save();
    }

    private async Task ConfirmFinish()
    {
        var current = exam!;
        var open = current.Questions.Count - current.AnsweredCount;
        var yes = await Dialogs.Confirm(open > 0 ? $"Noch {open} Fragen unbeantwortet. Trotzdem abgeben?" : "Prüfung jetzt abgeben?",
            ok: "Abgeben", cancel: "Weiter üben");
        if (yes && State.Progress.Exam == current) Finish(); // the timer may have finished it while the dialog was open
    }

    private void Finish()
    {
        StopTimer();
        State.Progress.FinishExam(Catalog, Clock.GetUtcNow());
        State.Save();
        Nav.NavigateTo("exam/result/0");
    }

    private void StopTimer()
    {
        timer?.Dispose();
        timer = null;
    }

    public void Dispose()
    {
        left = true;
        StopTimer();
    }
}
